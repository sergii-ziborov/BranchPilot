{
  "name": "branchpilot",
  "private": true,
  "version": "0.0.0",
  "productName": "BranchPilot",
  "description": "A desktop Git client for local repositories and hosted source providers.",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/prepare-dev.cjs && concurrently -k \"npm:dev:web\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:main": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5174 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 node scripts/run-electron.cjs --watch .",
    "electron:dev": "tsc -p tsconfig.electron.json && node scripts/run-electron.cjs .",
    "mcp:dev": "tsc -p tsconfig.electron.json && node dist-electron/electron/mcp/server.js",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:run": "npm run dist:mac && npm run start:mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder --mac --win",
    "start:mac": "node scripts/open-mac-build.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "electronmon": {
    "patterns": [
      "dist-electron/**",
      "!dist-electron/**/*.map"
    ]
  },
  "build": {
    "appId": "com.branchpilot.app",
    "productName": "BranchPilot",
    "asar": true,
    "files": [
      "dist",
      "dist-electron",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BranchPilot"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "isomorphic-git": "^1.38.6",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.185.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.0",
    "cross-env": "^10.1.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.10"
  }
}
